#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-only

set -euo pipefail

R="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"

usage() {
	cat <<EOF
dbx - containerized development environments

USAGE:
    dbx create          creates the devbox
    dbx [enter]         enters the devbox
    dbx proxy PORT      proxies a devbox port to the host
    dbx start           starts the devbox
EOF
}

cmd="${1:-enter}"
shift || true

case "$#:$cmd" in
	0:create|0:enter|1:proxy|0:start)
		"$r/dbx-$cmd" "$@"
		;;
	*)
		usage
		exit 1
		;;
esac

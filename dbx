set -euo pipefail

root="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"

usage() {
	cat <<EOF
dbx - containerized development environments

USAGE:
    dbx create          creates the devbox
    dbx [enter]         enters the devbox
    dbx proxy PORT      proxies a devbox port to the host
    dbx start           starts the devbox
    dbx stop            stops the devbox
EOF
}

cmd="${1:-enter}"
shift || true

case "$#:$cmd" in
	0:create|0:enter|1:proxy|0:start|0:stop)
		"$root/dbx-$cmd" "$@"
		;;
	*)
		usage
		exit 1
		;;
esac
